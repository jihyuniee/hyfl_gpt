# Configure these in Vercel Project Settings → Environment Variables.
# Existing installations already use these four names. Never put values in Git.
KV_REST_API_URL=
KV_REST_API_TOKEN=
OPENAI_KEY=
CLAUDE_KEY=

# Set a private teacher password. The old browser-side password is not used.
# Select Production and/or Preview as needed, then redeploy that environment.
ADMIN_PASSWORD=
# Optional dedicated session signing secret (long, random value).
# Without it, the server derives a domain-separated key from the KV token.
SESSION_SECRET=
# Optional exact production origin; leave unset for separate preview origins.
# APP_ORIGIN=https://hyfl-gpt.vercel.app

